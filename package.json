{
  "name": "poe-game-star",
  "version": "0.1.0",
  "private": true,
  "description": "Dark fantasy isometric ARPG — Phase 1 playable prototype",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:assets": "node scripts/generate-placeholders.mjs",
    "prebuild": "npm run generate:assets",
    "predev": "npm run generate:assets"
  },
  "dependencies": {
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  }
}
